<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteBase /daily_activity/

    # Remove index.php from URL
    RewriteCond %{THE_REQUEST} \s/+daily_activity/index\.php[?\s] [NC]
    RewriteRule ^index\.php(.*)$ /daily_activity$1 [R=301,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>